{
  "name": "p2pkanban-mobile",
  "version": "1.2.0-mobile.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "export:android": "expo export --platform android --output-dir dist/android-bundle",
    "apk": "node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@noble/ciphers": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@react-navigation/native": "7.3.14",
    "@react-navigation/native-stack": "7.18.6",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.8",
    "expo-build-properties": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "nostr-tools": "2.24.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@noble/.*|nostr-tools|expo(nent)?|expo-modules-core|@expo(nent)?/.*|@react-navigation/.*|react-native-safe-area-context|react-native-screens)/)"
    ]
  }
}
